# Pin policy lifted 2026-05-09 — operator decision: stop blocking updates,
# let upstream releases roll. Apps below are exceptions that MUST stay pinned.
#
# Layout: APP_VERSION=x.y.z (one per app). Append; never reorder existing keys.

# Tdarr — hard-pinned at 2.17.01. Newer releases require GLIBC 2.34; the
# Ultra.cc seedbox has GLIBC 2.31. Bumping breaks Tdarr binary compatibility.
# Bump only after confirming GLIBC 2.34 availability on the seedbox.
TDARR_VERSION=2.17.01

# unpackerr (QFLX-25): native static binary. Exact parity with the container
# version at swap time (UCC divorce I-10); scripts/configure/300-native-
# unpackerr-install.sh pins the same version + its sha256 (test-enforced).
UNPACKERR_VERSION=0.16.1

# sonarr2 (QFLX-30): native Sonarr v4 linux-x64 tarball. The UCC panel tool
# reports only major.minor.patch ("4.0.20"); the container's API reports the
# full 4.0.20.3014. scripts/configure/305-native-sonarr2-install.sh pins the full
# build + its sha256 and refuses unless the panel version is a dotted prefix of
# it AND the live API equals it (test-enforced against versions.env).
SONARR2_VERSION=4.0.20.3014

# radarr2 (QFLX-29): native linux-core-x64 tarball. The UCC panel tool reports
# only major.minor.patch ("6.4.4"); the container's API reports the full
# 6.4.4.10685. The installer pins the full build + its sha256 and refuses unless
# the panel version is a dotted prefix of it AND the live API equals it
# (test-enforced against versions.env). Own key: radarr (A7) pins separately.
RADARR2_VERSION=6.4.4.10685

# radarr (QFLX-31): native linux-core-x64 tarball. The UCC panel tool reports only
# major.minor.patch ("6.4.4"); the container's API reports the full 6.4.4.10685.
# The installer pins the full build + its sha256 and refuses unless the panel
# version is a dotted prefix of it AND the live API equals it (test-enforced
# against versions.env).
RADARR_VERSION=6.4.4.10685

# flaresolverr (QFLX-26): native PyInstaller release (bundled Chromium). Exact
# parity with the container version at swap time (I-10); scripts/configure/301-
# native-flaresolverr-install.sh pins the same version + its sha256 (test-enforced).
FLARESOLVERR_VERSION=3.5.2

# bazarr (QFLX-27): native release zip + venv. Exact parity with the container
# version at swap time (UCC divorce I-10); scripts/configure/302-native-bazarr-
# install.sh pins the same version + its sha256 (test-enforced). The unit's
# BAZARR_VERSION env (written by the installer) is what bazarr reports.
BAZARR_VERSION=1.6.2

# sabnzbd (QFLX-33): native source release + venv. Exact parity with the container
# version at swap time (I-10; `app-sabnzbd version` = 5.1.3 on 2026-10-10);
# scripts/configure/308-native-sabnzbd-install.sh pins the same version + the
# sha256 of the source tarball and of the par2/unrar/7zz helpers (test-enforced).
SABNZBD_VERSION=5.1.3

# prowlarr (QFLX-28): native linux-core-x64 tarball. The UCC panel tool reports
# only major.minor.patch ("2.6.5"); the container's API reports the full
# 2.6.5.5623. The installer pins the full build + its sha256 and refuses unless
# the panel version is a dotted prefix of it AND the live API equals it
# (test-enforced against versions.env).
PROWLARR_VERSION=2.6.5.5623

# sonarr (QFLX-32): native Sonarr v4 linux-x64 build. The UCC panel tool reports
# only major.minor.patch ("4.0.20"); the container's API reports the full
# 4.0.20.3014. The installer pins the full build + its sha256 and refuses unless
# the panel version is a dotted prefix of it AND the live API equals it
# (test-enforced against versions.env).
SONARR_VERSION=4.0.20.3014

# tautulli (QFLX-34): native tag release + python venv. Exact parity with the
# container version at swap time (I-10); scripts/configure/309-native-tautulli-
# install.sh pins the same version + the tag archive's sha256 (test-enforced).
TAUTULLI_VERSION=2.18.2

# qbittorrent (QFLX-35): ADOPTED, not converted - the static userdocs
# qbittorrent-nox the panel already runs (release-<ver>_v1.2.19). Exact parity
# with `app-qbittorrent version` at swap time (I-10); scripts/configure/310-
# native-qbittorrent-install.sh pins the same version + its sha256 (test-enforced).
QBITTORRENT_VERSION=5.0.3

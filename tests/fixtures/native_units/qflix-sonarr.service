[Unit]
Description=QFlix sonarr (native)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.apps/sonarr
Environment=PATH=%h/.apps/sonarr/bin/current:%h/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/qflix/sonarr.env
ExecStart=%h/.apps/sonarr/bin/current/Sonarr -nobrowser -data=%h/.apps/sonarr
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=600
StartLimitBurst=5
TimeoutStopSec=60
Nice=5
UMask=0002

[Install]
WantedBy=default.target

# Enforce LF line endings across the repo so Windows checkouts don't ship
# CRLF shell scripts to the Linux seedbox via scpm_to (which broke 4 cron
# heartbeats on 2026-05-11 — env couldn't resolve 'bash\r').
#
# The repo previously relied on the contributor's `git config core.autocrlf`
# being correct. It wasn't. `.gitattributes` overrides core.autocrlf, so this
# is now the single source of truth.

# Auto-detect text vs binary; for everything detected as text, store LF in the
# repo and check out LF in the working tree (on every platform).
* text=auto eol=lf

# Windows-host scripts keep CRLF — these never run on the seedbox.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary — never touch.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.zip      binary
*.tar      binary
*.tar.gz   binary
*.tgz      binary
*.gz       binary
*.bz2      binary
*.xz       binary
*.7z       binary
*.db       binary
*.sqlite   binary
*.sqlite3  binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
*.eot      binary
*.mp4      binary
*.webm     binary
*.mov      binary
*.mkv      binary
*.mp3      binary
*.wav      binary
*.flac     binary

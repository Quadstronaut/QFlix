[Unit]
Description=Manitoba canary - deploy drift (hourly)

[Timer]
# OnStartupSec, not OnBootSec (QFLX-55): a --user manager can start after a
# short OnBootSec has passed, and a monotonic-only timer then never fires.
OnStartupSec=9min
OnUnitActiveSec=1h
RandomizedDelaySec=120
Persistent=true
Unit=manitoba-maint-canary-deploy-drift.service

[Install]
WantedBy=timers.target

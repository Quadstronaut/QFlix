[Unit]
Description=Run Qflix weekly newsletter every Monday at 08:00 America/Phoenix (post-maintenance window)

[Timer]
# Operator timezone is Arizona (MST, no DST). 08:00 Phoenix sits an hour
# after the 04:00 Phoenix maintenance window, so subscribers see fresh
# digests AFTER any service reboots have settled.
OnCalendar=Mon 08:00:00 America/Phoenix
Persistent=true
Unit=qflix-newsletter.service

[Install]
WantedBy=timers.target

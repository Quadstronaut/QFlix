[Unit]
Description=QFlix sabnzbd (native)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.apps/sabnzbd
Environment=PATH=%h/.apps/sabnzbd/bin/current:%h/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/qflix/sabnzbd.env
ExecStart=%h/.apps/sabnzbd/bin/current/qflix-sabnzbd
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=600
StartLimitBurst=5
TimeoutStopSec=60
Nice=5
UMask=0002

[Install]
WantedBy=default.target

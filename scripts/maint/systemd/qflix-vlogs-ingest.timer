[Unit]
Description=QFlix vlogs ingest — every 5 minutes

[Timer]
# OnStartupSec, not OnBootSec (QFLX-55): a --user manager can start after a
# short OnBootSec has passed, and a monotonic-only timer then never fires.
OnStartupSec=2min
OnUnitActiveSec=5min
RandomizedDelaySec=30
Persistent=true

[Install]
WantedBy=timers.target

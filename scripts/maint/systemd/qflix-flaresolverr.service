[Unit]
Description=QFlix flaresolverr (native)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.apps/flaresolverr
Environment=PATH=%h/.apps/flaresolverr/bin/current:%h/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/qflix/flaresolverr.env
ExecStart=%h/.apps/flaresolverr/bin/current/flaresolverr
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=600
StartLimitBurst=5
TimeoutStopSec=60
Nice=5
UMask=0002

[Install]
WantedBy=default.target

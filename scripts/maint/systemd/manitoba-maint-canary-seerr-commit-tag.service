[Unit]
Description=Manitoba canary - Seerr client/server commitTag parity (baked bundle tag == /api/v1/status commitTag, else the "Seerr Updated" modal loops; QFLX-58)
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/scripts/maint/manitoba-maint canary push seerr-commit-tag
StandardOutput=journal
StandardError=journal

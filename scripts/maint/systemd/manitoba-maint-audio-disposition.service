[Unit]
Description=Manitoba maint — audio-disposition janitor (sole-default audio: Tdarr dual-default bug + English-default enforcement, anime excluded)
After=network-online.target

[Service]
Type=oneshot
# EXECUTE is armed deliberately: both predicates are narrow (the known Tdarr
# dual-default pattern, and a foreign-default file with a proven-tagged eng
# track — untagged defaults are refused outright, see classify_streams), the
# remux is stream-copy-only with a post-verify, and a dry-run plan was
# operator-reviewed before first enable (2026-07-19; foreign_default added
# 2026-09-13 after the Futurama S1 incident). Blast radius capped by
# --max-items in-script (default 25).
# --max-items 50: SUPERSEDES the original 2026-07-19 note, which claimed a
# 318-file initial backlog needing 50-a-night for roughly a week to fully
# clear — that dual_default-only backlog drained long ago. A full-library
# dry-run 2026-09-13 (both classes,
# real DEFAULT_ROOTS, 489 files scanned, operator-reviewed) found the
# backlog was 50 candidates across 24 titles (44 / 20 when re-measured the
# next day - it moves nightly); --max-items 50 bounds one run at the
# measured backlog instead of the seven nights the old note assumed. Left at 50
# (rather than raised) because it is also the per-run blast-radius cap this
# comment block already documents, and steady-state going forward is a
# handful of newly-imported files per day either way.
ExecStart=/usr/bin/python3 %h/scripts/maint/audio-disposition-janitor.py --execute --max-items 50
# Full-library ffprobe sweep + up to 25 large remuxes can run long.
# 2h -> 5h on 2026-08-08: a bulk re-acquisition (Vanderpump S5-S12, ~190
# episodes) fed Tdarr, Tdarr fed this janitor its dual-default output, and a
# full --max-items 50 night of remuxes needs ~4h on a loaded box. The 2h cap
# killed the run mid-batch (work already done was kept - each fix is atomic -
# but the end-of-run Kuma push never fired, so the monitor read "no heartbeat"
# on a night the janitor fixed 40+ files). 5h bounds a hung run well before
# the next 04:30 fire while letting a legitimate max-items night finish.
TimeoutStartSec=18000
StandardOutput=journal
StandardError=journal

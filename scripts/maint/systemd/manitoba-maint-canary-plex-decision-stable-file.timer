[Unit]
Description=Manitoba canary — Plex decision-failure adjudication (hourly)

[Timer]
# Hourly against a 26h window. The cadence is not the control here: a decision
# failure is history by the time it is logged, so there is nothing to catch in
# minutes. What matters is that the window is wider than the daily cycle the
# reaper and the *arr upgrade path run on, so one missed run can never drop an
# occurrence, and that the same occurrence re-adjudicates identically on every
# tick (the check is stateless and idempotent — it re-reads the log and re-stats
# the paths, so a red clears by itself once the file is deleted or replaced).
# PHASE-SHIFTED 2026-09-12: `hourly` means minute :00, and sixteen canaries
# plus eleven quarter-hourly ones all meant the same minute. That burst, on
# top of the pusher's 31 pushes a minute, is what Kuma's SQLite connection
# pool could not absorb -- six minutes of KnexTimeoutError on 2026-09-12,
# every push monitor tripping "No heartbeat in the time window", ~80 Discord
# messages for zero real faults. The PERIOD is still one hour; only the start
# minute moved, so every heartbeat timeout and lookback window sized against
# an hourly cadence stays exactly as valid as before.
OnCalendar=*:34:00
RandomizedDelaySec=240
Persistent=true

[Install]
WantedBy=timers.target

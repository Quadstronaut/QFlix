[Unit]
Description=QFlix prowlarr (native)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.apps/prowlarr
Environment=PATH=%h/.apps/prowlarr/bin/current:%h/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/qflix/prowlarr.env
ExecStart=%h/.apps/prowlarr/bin/current/Prowlarr -nobrowser -data=%h/.apps/prowlarr
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=600
StartLimitBurst=5
TimeoutStopSec=60
Nice=5
UMask=0002

[Install]
WantedBy=default.target

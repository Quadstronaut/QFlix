[Unit]
Description=QFlix sonarr2 (native)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.apps/sonarr2
Environment=PATH=%h/.apps/sonarr2/bin/current:%h/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/qflix/sonarr2.env
ExecStart=%h/.apps/sonarr2/bin/current/Sonarr -nobrowser -data=%h/.apps/sonarr2
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=600
StartLimitBurst=5
TimeoutStopSec=60
Nice=5
UMask=0002

[Install]
WantedBy=default.target

[Unit]
Description=QFlix tautulli (native)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.apps/tautulli
Environment=PATH=%h/.apps/tautulli/bin/current:%h/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/qflix/tautulli.env
ExecStart=%h/.apps/tautulli/bin/current/venv/bin/python %h/.apps/tautulli/bin/current/Tautulli.py --datadir %h/.apps/tautulli --port ${TAUTULLI_PORT} --nolaunch --quiet --nofork
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=600
StartLimitBurst=5
TimeoutStopSec=60
Nice=5
UMask=0002

[Install]
WantedBy=default.target

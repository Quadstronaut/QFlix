[Unit]
Description=QFlix unpackerr (native)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.apps/unpackerr
Environment=PATH=%h/.apps/unpackerr/bin/current:%h/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/qflix/unpackerr.env
ExecStart=%h/.apps/unpackerr/bin/current/unpackerr -c %h/.apps/unpackerr/unpackerr.conf
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=600
StartLimitBurst=5
TimeoutStopSec=60
Nice=5
UMask=0002

[Install]
WantedBy=default.target

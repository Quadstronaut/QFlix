[Unit]
Description=Manitoba canary - Tdarr uid relay / unix socket (hourly)

[Timer]
# :55 was one of the two minutes no hourly timer used (2026-11-03), so this
# adds no burst to Kuma's push pool (the 2026-09-12 KnexTimeoutError class).
# QFLX-97 considered every 15 min; every 15-minute phase collides with an
# hourly timer, and with tdarr-uid-relay.socket holding the port a dead relay
# is an outage the per-minute "Tdarr" probe already reds, not an opening.
OnCalendar=*:55:00 UTC
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target

[Unit]
Description=QFlix seerr (native)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.apps/seerr/bin/current
Environment=PATH=%h/.apps/seerr/bin/current:%h/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/qflix/seerr.env
ExecStart=%h/.apps/seerr/bin/node/bin/node --disable-wasm-trap-handler --require %h/.apps/seerr/native/seerr-listen.cjs %h/.apps/seerr/bin/current/dist/index.js
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=600
StartLimitBurst=5
TimeoutStopSec=60
Nice=5
UMask=0002

[Install]
WantedBy=default.target

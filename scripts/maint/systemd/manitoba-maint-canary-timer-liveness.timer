[Unit]
Description=Manitoba canary - timer liveness (every 15 min)

[Timer]
# OnStartupSec, not OnBootSec (QFLX-55): a --user manager can start after a
# short OnBootSec has passed, and a monotonic-only timer then never fires.
OnStartupSec=6min
OnUnitActiveSec=15min
RandomizedDelaySec=45
Persistent=true
Unit=manitoba-maint-canary-timer-liveness.service

[Install]
WantedBy=timers.target

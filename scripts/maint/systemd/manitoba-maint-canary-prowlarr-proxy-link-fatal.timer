[Unit]
Description=Manitoba canary — Prowlarr proxy-link fatal / 500-to-an-arr (every 30 min)

[Timer]
# Every 30 min against a 6-HOUR window. The window is the thing that controls
# paging, not the cadence: the 2026-09-06/07 episode fired about once per 87
# minutes, so a window sized to this timer would flap red/green/red and page on
# every red edge. Six hours stays continuously red for the life of an episode
# and self-clears ~6h after the last fatal, which is one page per episode.
# The cadence therefore only buys DETECTION LATENCY (<=30 min), and the check
# itself is a grep of two local files plus, on failure only, one loopback API
# call — cheap enough that a tighter cadence would be the wrong trade anyway.
# PHASE-SHIFTED 2026-09-12. The period is unchanged; only the START minute
# moved. At 03:16 and 03:18 CEST every push monitor in the fleet reported
# "No heartbeat in the time window" and Discord took ~80 messages, because
# Kuma's SQLite connection pool timed out for six minutes (KnexTimeoutError,
# recurring in the 03:00 hour since May). Nineteen canary timers fired in the
# SAME MINUTE at :00, on top of the pusher's 31 pushes a minute, and that
# burst is the load Kuma was least able to absorb. Widening
# RandomizedDelaySec was the wrong lever: it grows worst-case run spacing,
# which several canaries size their own lookback windows against. Moving the
# phase keeps consecutive runs exactly one period apart and leaves every
# downstream tuning valid.
OnCalendar=*:24/30
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target

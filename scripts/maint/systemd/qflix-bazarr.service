[Unit]
Description=QFlix bazarr (native)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.apps/bazarr
Environment=PATH=%h/.apps/bazarr/bin/current:%h/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/qflix/bazarr.env
ExecStart=%h/.apps/bazarr/venv/bin/python %h/.apps/bazarr/bin/current/bazarr.py --no-update --config %h/.apps/bazarr
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=600
StartLimitBurst=5
TimeoutStopSec=60
Nice=5
UMask=0002

[Install]
WantedBy=default.target

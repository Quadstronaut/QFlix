[Unit]
Description=Manitoba canary — Prowlarr app-sync integrity (hourly)

[Timer]
# Hourly, not every-15min: both predicates are CONFIG state, not a burst.
# An indexer missing from an *arr stays missing until an operator fixes it
# (LimeTorrents has been absent from Radarr for ~10 weeks), and
# preferMagnetUrl does not flap. Prowlarr's own ApplicationIndexerSync runs on
# a 6-hour cycle, so hourly already samples six times per sync attempt while
# costing six API calls an hour instead of twenty-four.
# PHASE-SHIFTED 2026-09-12: `hourly` means minute :00, and sixteen canaries
# plus eleven quarter-hourly ones all meant the same minute. That burst, on
# top of the pusher's 31 pushes a minute, is what Kuma's SQLite connection
# pool could not absorb -- six minutes of KnexTimeoutError on 2026-09-12,
# every push monitor tripping "No heartbeat in the time window", ~80 Discord
# messages for zero real faults. The PERIOD is still one hour; only the start
# minute moved, so every heartbeat timeout and lookback window sized against
# an hourly cadence stays exactly as valid as before.
OnCalendar=*:36:00
RandomizedDelaySec=180
Persistent=true

[Install]
WantedBy=timers.target

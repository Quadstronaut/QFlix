[Unit]
Description=QFlix Dashboard (SvelteKit adapter-node)
After=network-online.target

[Service]
Type=exec
WorkingDirectory=%h/.apps/qflix-dash
EnvironmentFile=%h/.config/qflix-dash/qflix-dash.env
# @@NODE@@ = %h/.apps/qflix-dash/bin/node/bin/node: the dash's OWN pinned Node
# (versions.env QFLIX_DASH_NODE_VERSION) via the bin/node symlink, so the unit
# never depends on login-shell PATH or on Seerr's Node (QFLX-93).
ExecStart=@@NODE@@ %h/.apps/qflix-dash/build/index.js
Restart=on-failure
RestartSec=3
StandardOutput=append:%h/.apps/qflix-dash/logs/app.log
StandardError=append:%h/.apps/qflix-dash/logs/app.log

[Install]
WantedBy=default.target

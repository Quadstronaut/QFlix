<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ ctx.subject }}</title>
{% macro filmstrip() -%}
<tr><td style="padding:0;">
  <div style="height:18px;background:repeating-linear-gradient(90deg,#0a0a0a 0,#0a0a0a 8px,#1a1a1a 8px,#1a1a1a 14px);border-top:1px solid #2a2a2a;border-bottom:1px solid #2a2a2a;line-height:0;font-size:0;">&nbsp;</div>
</td></tr>
{%- endmacro %}
</head>
<body style="margin:0;padding:0;background:#0a1628;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#cbd5e1;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#0a1628;">
  <tr><td align="center" style="padding:32px 12px;">
    <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="max-width:600px;width:100%;">

      {# Header — amber gradient signals "ATTENTION — upstream provider" #}
      <tr><td style="padding:0;">
        <div style="background:linear-gradient(180deg,#000 0%,#7c2d12 50%,#0a1628 100%);padding:36px 16px 28px 16px;text-align:center;">
          {# Backup if Manitoba is hard-down: https://raw.githubusercontent.com/Quadstronaut/QFlix/master/Q.png #}
          <img src="https://{{ ctx.public_host }}/images/Q.png" alt="QFlix" width="96" height="96" style="display:inline-block;width:96px;height:96px;border-radius:50%;box-shadow:0 6px 28px rgba(255,255,255,.15),0 4px 24px rgba(251,146,60,.5);">
          <div style="font-size:38px;font-weight:600;color:#ffffff;letter-spacing:1px;margin-top:14px;">QFlix</div>
          <div style="width:48px;height:2px;background:#fb923c;margin:10px auto;line-height:0;font-size:0;">&nbsp;</div>
          <div style="font-size:13px;color:#fdba74;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;">Upstream provider maintenance · starting</div>
        </div>
      </td></tr>

      {{ filmstrip() }}

      {# Hero alert card #}
      <tr><td style="padding:24px 16px 8px 16px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#0e1d33;border:1px solid rgba(251,146,60,.4);border-radius:8px;">
          <tr><td style="padding:24px 20px;text-align:center;">
            <div style="font-size:48px;line-height:1;">🔧</div>
            <h2 style="margin:12px 0 0 0;color:#f8fafc;font-size:22px;font-weight:600;">Our host is performing maintenance</h2>
            <div style="margin-top:12px;color:#cbd5e1;font-size:14px;line-height:1.6;">
              Our upstream hosting provider has started a maintenance window. Some monitoring checks
              may appear degraded during this time — that's expected and normal. Plex and your
              media requests should continue working without interruption.
            </div>
            <div style="margin-top:20px;">
              <a href="https://{{ ctx.kuma_public_host }}/status/public" style="display:inline-block;background:linear-gradient(135deg,#fb923c,#c2410c);color:#0a1628;text-decoration:none;font-size:14px;font-weight:700;letter-spacing:.5px;padding:12px 24px;border-radius:6px;box-shadow:0 4px 14px rgba(251,146,60,.4);">Live status →</a>
            </div>
            <div style="margin-top:14px;color:#7dd3fc;font-size:11px;opacity:.7;">
              {{ ctx.kuma_public_host }}/status/public
            </div>
          </td></tr>
        </table>
      </td></tr>

      {# What to expect #}
      <tr><td style="padding:16px 16px 8px 16px;">
        <div style="background:#05101f;border:1px solid rgba(125,211,252,.10);border-radius:6px;padding:14px 16px;">
          <div style="color:#7dd3fc;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;">What you might see</div>
          <div style="color:#cbd5e1;font-size:13px;margin-top:8px;line-height:1.6;">
            The status page may show some monitors as degraded while the host performs its work.
            This is not a QFlix outage — it's an infrastructure maintenance signal. Keep streaming;
            we'll send another email once the provider clears the window.
          </div>
        </div>
      </td></tr>

      {{ filmstrip() }}

      {# Footer #}
      <tr><td style="padding:0;">
        <div style="background:linear-gradient(180deg,#0a1628 0%,#000 100%);padding:28px 16px 36px 16px;text-align:center;">
          {# Backup if Manitoba is hard-down: https://raw.githubusercontent.com/Quadstronaut/QFlix/master/Q.png #}
          <img src="https://{{ ctx.public_host }}/images/Q.png" alt="" width="40" height="40" style="display:inline-block;width:40px;height:40px;border-radius:50%;box-shadow:0 2px 12px rgba(30,64,175,.4);">
          <div style="color:#cbd5e1;font-size:12px;margin-top:10px;letter-spacing:.3px;">QFlix · Crafted with precision 🩷 Quadstronaut</div>
          <div style="color:#7dd3fc;font-size:11px;opacity:.5;margin-top:10px;">
            <a href="{{ '{{ UnsubscribeURL }}' }}" style="color:#7dd3fc;text-decoration:underline;">Unsubscribe</a>
            ·
            <a href="{{ '{{ MessageURL }}' }}" style="color:#7dd3fc;text-decoration:underline;">View in browser</a>
          </div>
        </div>
      </td></tr>
    </table>
  </td></tr>
</table>
</body>
</html>

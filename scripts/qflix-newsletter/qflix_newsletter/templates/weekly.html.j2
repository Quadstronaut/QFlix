<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ ctx.subject }}</title>
{% macro filmstrip() -%}
<tr><td style="padding:0;">
  <div style="height:18px;background:repeating-linear-gradient(90deg,#0a0a0a 0,#0a0a0a 8px,#1a1a1a 8px,#1a1a1a 14px);border-top:1px solid #2a2a2a;border-bottom:1px solid #2a2a2a;line-height:0;font-size:0;">&nbsp;</div>
</td></tr>
{%- endmacro %}
{% macro count_badge(text) -%}
<span style="background:#1e40af;color:#fff;padding:2px 10px;border-radius:12px;font-size:11px;font-weight:600;margin-left:6px;vertical-align:middle;">{{ text }}</span>
{%- endmacro %}
{% macro section_divider() -%}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top:6px;">
  <tr>
    <td style="height:1px;background:#7dd3fc;opacity:.6;line-height:0;font-size:0;">&nbsp;</td>
    <td width="20" align="center" style="color:#d4af37;font-size:11px;line-height:1;padding:0 6px;">&#9670;</td>
    <td style="height:1px;background:#7dd3fc;opacity:.6;line-height:0;font-size:0;">&nbsp;</td>
  </tr>
</table>
{%- endmacro %}
</head>
<body style="margin:0;padding:0;background:#0a1628;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#cbd5e1;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#0a1628;">
  <tr><td align="center" style="padding:32px 12px;">
    <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="max-width:600px;width:100%;">

      {# Header — hero with Q.png on top-down black→blue→bg gradient #}
      <tr><td style="padding:0;">
        <div style="background:linear-gradient(180deg,#000 0%,#1e3a8a 50%,#0a1628 100%);padding:36px 16px 28px 16px;text-align:center;">
          {# Backup if Manitoba is hard-down: https://raw.githubusercontent.com/Quadstronaut/QFlix/master/Q.png #}
          <img src="https://{{ ctx.public_host }}/images/Q.png" alt="QFlix" width="96" height="96" style="display:inline-block;width:96px;height:96px;border-radius:50%;box-shadow:0 6px 28px rgba(255,255,255,.15),0 4px 24px rgba(30,64,175,.5);">
          <div style="font-size:38px;font-weight:600;color:#ffffff;letter-spacing:1px;margin-top:14px;">QFlix</div>
          <div style="width:48px;height:2px;background:#d4af37;margin:10px auto;line-height:0;font-size:0;">&nbsp;</div>
          <div style="font-size:13px;color:#7dd3fc;">{{ ctx.week_label }}</div>
        </div>
      </td></tr>
      {{ filmstrip() }}

      {# Pick of the Week — gold corner ribbon replaces standalone label row #}
      {% if ctx.pick %}
      <tr><td style="padding:20px 16px 24px 16px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#0e1d33;border:1px solid rgba(212,175,55,.4);border-radius:8px;overflow:hidden;position:relative;">
          <tr><td style="padding:0;position:relative;">
            <div style="position:absolute;top:18px;right:-38px;background:linear-gradient(135deg,#e8c456,#b8941f);color:#0a1628;padding:4px 44px;transform:rotate(30deg);font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;box-shadow:0 2px 8px rgba(0,0,0,.5);z-index:2;">Pick of the Week</div>
          </td></tr>
          {% if ctx.pick.thumb_url %}
          <tr><td align="center" style="padding:24px 16px 8px 16px;">
            <img src="{{ ctx.pick.thumb_url }}" alt="" width="220" style="display:block;max-width:100%;height:auto;border-radius:6px;box-shadow:0 8px 24px rgba(0,0,0,.7);">
          </td></tr>
          {% endif %}
          <tr><td style="padding:12px 16px 4px 16px;">
            <h2 style="margin:0;color:#f8fafc;font-size:22px;font-weight:600;">
              {{ ctx.pick.title }}{% if ctx.pick.year %} <span style="color:#7dd3fc;font-weight:400;">({{ ctx.pick.year }})</span>{% endif %}
            </h2>
            {% if ctx.pick.rating %}
            <div style="margin-top:6px;color:#d4af37;font-size:13px;">★ {{ '%.1f'|format(ctx.pick.rating) }}</div>
            {% endif %}
          </td></tr>
          <tr><td style="padding:8px 16px 16px 16px;color:#cbd5e1;font-size:14px;line-height:1.55;">
            {{ ctx.pick.summary | truncate(280) }}
          </td></tr>
        </table>
      </td></tr>
      {% endif %}

      {# New Movies #}
      {% if ctx.movies %}
      <tr><td style="padding:8px 16px;">
        <h3 style="margin:0;color:#f8fafc;font-size:18px;font-weight:600;">🎬 New movies{{ count_badge(ctx.movies | length) }}</h3>
{{ section_divider() }}
      </td></tr>
      <tr><td style="padding:0 16px 16px 16px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
          {% for chunk in ctx.movies | batch(3, fill_with=None) %}
          <tr>
            {% for m in chunk %}
            <td width="33%" valign="top" style="padding:6px;{% if loop.index > 1 %}{% endif %}">
              {% if m %}
              <div style="background:#0e1d33;border:1px solid rgba(212,175,55,.4);border-radius:6px;padding:8px;text-align:center;box-shadow:0 6px 16px rgba(0,0,0,.6);">
                {% if m.thumb_url %}
                <img src="{{ m.thumb_url }}" alt="" width="160" style="display:block;max-width:100%;height:auto;border-radius:4px;margin:0 auto 8px auto;">
                {% endif %}
                <div style="color:#f8fafc;font-size:13px;font-weight:600;line-height:1.3;">{{ m.title }}</div>
                {% if m.year %}<div style="color:#7dd3fc;font-size:11px;margin-top:2px;">{{ m.year }}</div>{% endif %}
                {% if m.rating %}<div style="color:#d4af37;font-size:11px;margin-top:2px;">★ {{ '%.1f'|format(m.rating) }}</div>{% endif %}
              </div>
              {% endif %}
            </td>
            {% endfor %}
          </tr>
          {% endfor %}
        </table>
      </td></tr>
      {% endif %}

      {# New TV (grouped) #}
      {% if ctx.shows %}
      <tr><td style="padding:8px 16px;">
        <h3 style="margin:0;color:#f8fafc;font-size:18px;font-weight:600;">📺 New TV{{ count_badge((ctx.shows | length | string) + ' shows · ' + (ctx.shows | sum(attribute='episode_count') | string) + ' eps') }}</h3>
{{ section_divider() }}
      </td></tr>
      {% for s in ctx.shows %}
      <tr><td style="padding:0 16px 8px 16px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#0e1d33;border:1px solid rgba(125,211,252,.12);border-radius:6px;">
          <tr>
            {% if s.thumb_url %}
            <td width="80" valign="top" style="padding:8px;">
              <img src="{{ s.thumb_url }}" alt="" width="64" style="display:block;border-radius:4px;">
            </td>
            {% endif %}
            <td valign="top" style="padding:10px 12px;">
              <div style="color:#f8fafc;font-size:15px;font-weight:600;">{{ s.show_title }}</div>
              <div style="color:#7dd3fc;font-size:12px;margin-top:2px;">{{ s.season_episode_label }}</div>
            </td>
          </tr>
        </table>
      </td></tr>
      {% endfor %}
      {% endif %}

      {# Anime Movies #}
      {% if ctx.anime_movies %}
      <tr><td style="padding:8px 16px;">
        <h3 style="margin:0;color:#f8fafc;font-size:18px;font-weight:600;">🌸 New anime movies{{ count_badge(ctx.anime_movies | length) }}</h3>
{{ section_divider() }}
      </td></tr>
      <tr><td style="padding:0 16px 16px 16px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
          {% for chunk in ctx.anime_movies | batch(3, fill_with=None) %}
          <tr>
            {% for m in chunk %}
            <td width="33%" valign="top" style="padding:6px;">
              {% if m %}
              <div style="background:#0e1d33;border:1px solid rgba(212,175,55,.4);border-radius:6px;padding:8px;text-align:center;box-shadow:0 6px 16px rgba(0,0,0,.6);">
                {% if m.thumb_url %}<img src="{{ m.thumb_url }}" alt="" width="160" style="display:block;max-width:100%;height:auto;border-radius:4px;margin:0 auto 8px auto;">{% endif %}
                <div style="color:#f8fafc;font-size:13px;font-weight:600;line-height:1.3;">{{ m.title }}</div>
                {% if m.year %}<div style="color:#7dd3fc;font-size:11px;margin-top:2px;">{{ m.year }}</div>{% endif %}
              </div>
              {% endif %}
            </td>
            {% endfor %}
          </tr>
          {% endfor %}
        </table>
      </td></tr>
      {% endif %}

      {# Anime TV #}
      {% if ctx.anime_shows %}
      <tr><td style="padding:8px 16px;">
        <h3 style="margin:0;color:#f8fafc;font-size:18px;font-weight:600;">🍙 New anime TV{{ count_badge((ctx.anime_shows | length | string) + ' shows · ' + (ctx.anime_shows | sum(attribute='episode_count') | string) + ' eps') }}</h3>
{{ section_divider() }}
      </td></tr>
      {% for s in ctx.anime_shows %}
      <tr><td style="padding:0 16px 8px 16px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#0e1d33;border:1px solid rgba(125,211,252,.12);border-radius:6px;">
          <tr>
            {% if s.thumb_url %}<td width="80" valign="top" style="padding:8px;"><img src="{{ s.thumb_url }}" alt="" width="64" style="display:block;border-radius:4px;"></td>{% endif %}
            <td valign="top" style="padding:10px 12px;">
              <div style="color:#f8fafc;font-size:15px;font-weight:600;">{{ s.show_title }}</div>
              <div style="color:#7dd3fc;font-size:12px;margin-top:2px;">{{ s.season_episode_label }}</div>
            </td>
          </tr>
        </table>
      </td></tr>
      {% endfor %}
      {% endif %}

      {# Coming Soon #}
      {% if ctx.coming_soon %}
      <tr><td style="padding:16px 16px 8px 16px;">
        <h3 style="margin:0;color:#f8fafc;font-size:18px;font-weight:600;">🗓 Coming soon{{ count_badge(ctx.coming_soon[:12] | length) }}</h3>
{{ section_divider() }}
      </td></tr>
      <tr><td style="padding:0 16px 16px 16px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
          {% for c in ctx.coming_soon[:12] %}
          <tr>
            <td valign="top" style="padding:6px 10px;border-bottom:1px solid rgba(125,211,252,.08);">
              <div style="color:#f8fafc;font-size:14px;font-weight:600;">
                {% if c.media_type == 'tv' and c.show_title %}{{ c.show_title }}: {{ c.title }}{% else %}{{ c.title }}{% endif %}
              </div>
              <div style="color:#7dd3fc;font-size:11px;margin-top:2px;">
                {{ c.air_date.strftime('%a %b %d') }}
                {% if c.media_type == 'tv' and c.season is not none and c.episode is not none %}
                · S{{ '%02d'|format(c.season) }}E{{ '%02d'|format(c.episode) }}
                {% endif %}
              </div>
            </td>
          </tr>
          {% endfor %}
        </table>
      </td></tr>
      {% endif %}

      {# Behind the scenes — weekly improvement recap. Renders a Claude-authored
         blurb from the newsletter-digest branch when the scheduled routine
         posted one this week, else a deterministic recap from the week's public
         commits. Replaces the retired Gemini AI Picks section. #}
      {% if ctx.behind_scenes and ctx.behind_scenes.has_items %}
      {% set bs = ctx.behind_scenes %}
      <tr><td style="padding:16px 16px 8px 16px;">
        <h3 style="margin:0;color:#f8fafc;font-size:18px;font-weight:600;">🔧 Behind the scenes</h3>
{{ section_divider() }}
        <div style="color:#7dd3fc;font-size:11px;opacity:.7;margin-top:4px;">What we improved for you this week</div>
      </td></tr>
      <tr><td style="padding:0 16px 16px 16px;">
        <div style="background:#05101f;border:1px solid rgba(125,211,252,.10);border-radius:6px;padding:14px 16px;">
          {% if bs.has_blurb %}
          {# Trusted, Claude-authored inline HTML — intentionally not escaped. The
             blurb already narrates the week (incl. any tune-ups), so the
             deterministic upgrade line is NOT shown here — it would duplicate. #}
          <div style="color:#cbd5e1;font-size:14px;line-height:1.6;">{{ bs.blurb_html | safe }}</div>
          {% else %}
          {# No human blurb this week — lead the commit recap with the concrete
             "what we tuned" upgrade line (the only place it renders). #}
          {% if bs.has_upgrades %}
          <div style="color:#7dd3fc;font-size:11px;text-transform:uppercase;letter-spacing:1px;font-weight:700;">⚙️ This week's tune-ups</div>
          <div style="color:#cbd5e1;font-size:13px;line-height:1.5;margin:4px 0 10px 0;">{{ bs.upgrade_phrase | e }}</div>
          {% endif %}
          {% if bs.features %}
          <div style="color:#7dd3fc;font-size:11px;text-transform:uppercase;letter-spacing:1px;font-weight:700;">✨ New</div>
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:4px 0 10px 0;">
            {% for c in bs.features %}
            <tr><td style="color:#cbd5e1;font-size:13px;line-height:1.5;padding:2px 0;">• {{ c.display | e }}</td></tr>
            {% endfor %}
            {% if bs.feature_overflow %}
            <tr><td style="color:#7dd3fc;font-size:11px;opacity:.6;padding:2px 0;">+{{ bs.feature_overflow }} more</td></tr>
            {% endif %}
          </table>
          {% endif %}
          {% if bs.fixes %}
          <div style="color:#7dd3fc;font-size:11px;text-transform:uppercase;letter-spacing:1px;font-weight:700;">🔧 Fixes &amp; tune-ups</div>
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:4px 0 6px 0;">
            {% for c in bs.fixes %}
            <tr><td style="color:#cbd5e1;font-size:13px;line-height:1.5;padding:2px 0;">• {{ c.display | e }}</td></tr>
            {% endfor %}
            {% if bs.fix_overflow %}
            <tr><td style="color:#7dd3fc;font-size:11px;opacity:.6;padding:2px 0;">+{{ bs.fix_overflow }} more</td></tr>
            {% endif %}
          </table>
          {% endif %}
          <div style="color:#7dd3fc;font-size:11px;opacity:.55;margin-top:8px;border-top:1px solid rgba(125,211,252,.08);padding-top:8px;">
            {{ bs.feature_count }} new {{ 'feature' if bs.feature_count == 1 else 'features' }}
            · {{ bs.fix_count }} {{ 'fix' if bs.fix_count == 1 else 'fixes' }}
            {% if bs.generated_label %} · {{ bs.generated_label }}{% endif %}
          </div>
          {% endif %}
        </div>
      </td></tr>
      {% endif %}

      {# Nerd Corner #}
      {% if ctx.nerd_corner %}
      <tr><td style="padding:16px 16px 16px 16px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#05101f;border:1px solid rgba(125,211,252,.10);border-radius:6px;">
          <tr><td style="padding:12px 14px;">
            <div style="color:#7dd3fc;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;">🤓 Nerd corner</div>
            <div style="color:#cbd5e1;font-size:12px;margin-top:6px;">
              <span style="color:#f8fafc;font-weight:600;">{{ ctx.nerd_corner.total_items }}</span> items in library
              {% for s in ctx.nerd_corner.sections %}
              · {{ s.name }} <span style="color:#f8fafc;">{{ s.count }}</span>
              {% endfor %}
            </div>
          </td></tr>
        </table>
      </td></tr>
      {% endif %}

      {{ filmstrip() }}

      {# Footer — bg→black gradient, 40px Q monogram, operator-corrected tagline #}
      <tr><td style="padding:0;">
        <div style="background:linear-gradient(180deg,#0a1628 0%,#000 100%);padding:28px 16px 36px 16px;text-align:center;">
          {# Backup if Manitoba is hard-down: https://raw.githubusercontent.com/Quadstronaut/QFlix/master/Q.png #}
          <img src="https://{{ ctx.public_host }}/images/Q.png" alt="" width="40" height="40" style="display:inline-block;width:40px;height:40px;border-radius:50%;box-shadow:0 2px 12px rgba(30,64,175,.4);">
          <div style="color:#cbd5e1;font-size:12px;margin-top:10px;letter-spacing:.3px;">QFlix · Crafted with precision 🩷 Quadstronaut</div>
          <div style="color:#7dd3fc;font-size:11px;opacity:.5;margin-top:10px;">
            <a href="{{ '{{ UnsubscribeURL }}' }}" style="color:#7dd3fc;text-decoration:underline;">Unsubscribe</a>
            ·
            <a href="{{ '{{ MessageURL }}' }}" style="color:#7dd3fc;text-decoration:underline;">View in browser</a>
          </div>
        </div>
      </td></tr>
    </table>
  </td></tr>
</table>
</body>
</html>
